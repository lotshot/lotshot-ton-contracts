#include "imports/stdlib.fc";
#include "imports/functions.fc";
#include "imports/op-codes.fc";

int JACKPOT_PRIZE() asm "10000 PUSHINT"; ;; 10,000 tokens
int MAJOR_PRIZE() asm "1800 PUSHINT";    ;; 1,800 tokens
int HIGH_PRIZE() asm "700 PUSHINT";      ;; 700 tokens
int MID_PRIZE() asm "180 PUSHINT";       ;; 180 tokens
int LOW_MID_PRIZE() asm "50 PUSHINT";    ;; 50 tokens
int LOW_PRIZE() asm "25 PUSHINT";        ;; 25 tokens
int MINI_PRIZE() asm "10 PUSHINT";       ;; 10 tokens

(
    cell, ;; counters
    int, ;; next_ticket_index
    slice, ;; owner address
    int, ;; ticket_price (jettons)
    int, ;; ref_percent
    slice, ;; token_wallet_address
    slice ;; collection_address
) load_data() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_ref(),
        ds~load_uint(64),
        ds~load_msg_addr(),
        ds~load_uint(128), ;; ticket_price in jettons
        ds~load_uint(16),
        ds~load_msg_addr(),
        ds~load_msg_addr()
    );
}

() store_data(
cell counters_ref,
int next_ticket_index,
slice admin_address,
int price,
int ref_percent,
slice token_wallet_address,
slice collection_address
) impure inline {
    set_data(
        begin_cell()
            .store_ref(counters_ref)
            .store_uint(next_ticket_index, 64)
            .store_slice(admin_address)
            .store_uint(price, 128)
            .store_uint(ref_percent, 16)
            .store_slice(token_wallet_address)
            .store_slice(collection_address)
            .end_cell()
    );
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);

    if (flags & 1) {
        return();
    }

    slice sender_address = cs~load_msg_addr();
    var (
        cell counters_ref,
        int next_ticket_index,
        slice admin_address,
        int price,
        int ref_percent,
        slice token_wallet_address
    ) = load_data();

    int op = in_msg_body.preload_uint(32);

    if (op == 0x7362d09c) { ;; jetton transfer notification
        ;; убеждаемся, что уведомление пришло именно
        ;; от jetton-кошелька этой лотереи
        throw_unless(402, equal_slices(sender_address, token_wallet_address));
        in_msg_body~load_uint(32); ;; op
        in_msg_body~load_uint(64); ;; query_id
        int amount = in_msg_body~load_coins();
        slice sender_wallet = in_msg_body~load_msg_addr();

        int is_cell = in_msg_body~load_uint(1);
        slice fwd_payload = begin_cell().end_cell().begin_parse();
        if (is_cell == 0) {
            fwd_payload = in_msg_body;
        } else {
            fwd_payload = in_msg_body~load_ref().begin_parse();
        }

        throw_unless(400, msg_value >= forward_fee());
        throw_unless(400, amount >= price);

        int excess = amount - price;
        if (excess > 0) {
            var refund_transfer = begin_cell()
                .store_uint(op::jetton_transfer(), 32)  ;; use constant for clarity
                .store_uint(0, 64)
                .store_coins(excess)
                .store_slice(sender_wallet)
                .store_slice(my_address())
                .store_maybe_ref(null())
                .store_coins(outer_fee())
                .store_uint(0, 1)
                .end_cell();

            var refund_msg = begin_cell()
                .store_uint(flag::regular(), 6) ;; internal, no bounce (TONs вернутся контракту)
                .store_slice(token_wallet_address)
                .store_coins(outer_fee())
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_ref(refund_transfer)
                .end_cell();
            send_raw_message(refund_msg, 1);
        }

        slice player_address = sender_wallet;
        slice ref_addr = null_addr();
        int has_ref = 0;
        int prize_code = -1;

        ;; ---------- разбор fwd_payload ----------
        int maybe_op = -1;
        if (slice_bits(fwd_payload) >= 32) {
            maybe_op = fwd_payload~preload_uint(32);
        }

        if (maybe_op == op::send_prize()) {
            ;; служебный payload: 32-битный op-код + 8-бит prize_code
            fwd_payload~load_uint(32);          ;; op
            prize_code = fwd_payload~load_uint(8);
        } else {
            ;; payload содержит адрес игрока и, возможно, адрес реферала
            player_address = fwd_payload~load_msg_addr();   ;; первый адрес — всегда игрок
            if (slice_bits(fwd_payload) >= 267) {           ;; хватает бит на второй адрес?
                ref_addr = fwd_payload~load_msg_addr();
                has_ref  = 1;
            }
        }

        if (has_ref) {
            int referral_amount = (price * ref_percent) / 10000;  ;; 100 %=10 000 bp
            if (referral_amount > 0) {
                var ref_transfer = begin_cell()
                    .store_uint(op::jetton_transfer(), 32)
                    .store_uint(0, 64)
                    .store_coins(referral_amount)
                    .store_slice(ref_addr)
                    .store_slice(sender_wallet)
                    .store_maybe_ref(null())
                    .store_coins(outer_fee())
                    .store_uint(0, 1)
                    .end_cell();

                var ref_msg = begin_cell()
                    .store_uint(flag::regular(), 6)
                    .store_slice(token_wallet_address)
                    .store_coins(outer_fee())
                    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                    .store_ref(ref_transfer)
                    .end_cell();
                send_raw_message(ref_msg, 1);
            }
        }

        randomize_lt();
        var x = rand(120);

        slice counters_slice = counters_ref.begin_parse();
        int jp = counters_slice~load_uint(16);
        int major = counters_slice~load_uint(16);
        int high = counters_slice~load_uint(16);
        int mid = counters_slice~load_uint(16);
        int low_mid = counters_slice~load_uint(16);
        int low = counters_slice~load_uint(16);
        int mini = counters_slice~load_uint(16);

        if (jp > 0) {
            return();
        }

        if (x == 0) { ;; Выпал 0
            if (jp == 0) { ;; Jack pot еще не был разыгран
                next_ticket_index += 1;
                ;; jp += 1;
                cell new_ref = begin_cell()
                    .store_uint(jp, 16)
                    .store_uint(major, 16)
                    .store_uint(high, 16)
                    .store_uint(mid, 16)
                    .store_uint(low_mid, 16)
                    .store_uint(low, 16)
                    .store_uint(mini, 16)
                    .end_cell();

                var msg = begin_cell()
                    .store_uint(flag::regular(), 6)
                    .store_slice(admin_address)
                    .store_coins(50000000)            ;; 0.05 TON
                    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                    .store_uint(0, 32)
                    .store_slice("Jackpot winner")
                    .end_cell();


                send_raw_message(msg, 1);


                store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
                return();

                ;; Отправить сообщение админу
            }
        }

        if (x < 3) { ;; выпало до 4
            if (major < 3) { ;; Выигрышей Major меньше 3
                major += 1;
                next_ticket_index += 1;
                send_winning(MAJOR_PRIZE(), player_address, 1, token_wallet_address);

                cell new_ref = begin_cell()
                    .store_uint(jp, 16)
                    .store_uint(major, 16)
                    .store_uint(high, 16)
                    .store_uint(mid, 16)
                    .store_uint(low_mid, 16)
                    .store_uint(low, 16)
                    .store_uint(mini, 16)
                    .end_cell();
                store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
                return();
            }
        }

        if (x < 8) {
            if (high < 10) {
                next_ticket_index += 1;
                high += 1;

                send_winning(HIGH_PRIZE(), player_address, 2, token_wallet_address);

                cell new_ref = begin_cell()
                    .store_uint(jp, 16)
                    .store_uint(major, 16)
                    .store_uint(high, 16)
                    .store_uint(mid, 16)
                    .store_uint(low_mid, 16)
                    .store_uint(low, 16)
                    .store_uint(mini, 16)
                    .end_cell();
                store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
                return();
            }
        }

        if (x < 28) {
            if (mid < 35) {
                next_ticket_index += 1;
                mid += 1;

                send_winning(MID_PRIZE(), player_address, 3, token_wallet_address);

                cell new_ref = begin_cell()
                    .store_uint(jp, 16)
                    .store_uint(major, 16)
                    .store_uint(high, 16)
                    .store_uint(mid, 16)
                    .store_uint(low_mid, 16)
                    .store_uint(low, 16)
                    .store_uint(mini, 16)
                    .end_cell();
                store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
                return();
            }
        }

        if (x < 48) {
            if (low_mid < 35) {
                next_ticket_index += 1;
                low_mid += 1;

                send_winning(LOW_MID_PRIZE(), player_address, 4, token_wallet_address);

                cell new_ref = begin_cell()
                    .store_uint(jp, 16)
                    .store_uint(major, 16)
                    .store_uint(high, 16)
                    .store_uint(mid, 16)
                    .store_uint(low_mid, 16)
                    .store_uint(low, 16)
                    .store_uint(mini, 16)
                    .end_cell();
                store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
                return();
            }
        }

        if (x < 73) {
            if (low < 30) {
                next_ticket_index += 1;
                low += 1;

                send_winning(LOW_PRIZE(), player_address, 5, token_wallet_address);

                cell new_ref = begin_cell()
                    .store_uint(jp, 16)
                    .store_uint(major, 16)
                    .store_uint(high, 16)
                    .store_uint(mid, 16)
                    .store_uint(low_mid, 16)
                    .store_uint(low, 16)
                    .store_uint(mini, 16)
                    .end_cell();
                store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
                return();
            }
        }

        if (x < 108) {
            if (mini < 7) {
                next_ticket_index += 1;
                mini += 1;

                send_winning(MINI_PRIZE(), player_address, 6, token_wallet_address);

                cell new_ref = begin_cell()
                    .store_uint(jp, 16)
                    .store_uint(major, 16)
                    .store_uint(high, 16)
                    .store_uint(mid, 16)
                    .store_uint(low_mid, 16)
                    .store_uint(low, 16)
                    .store_uint(mini, 16)
                    .end_cell();
                store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
                return();
            }
        }

        next_ticket_index += 1;

        send_winning(0, player_address, 7, token_wallet_address);

        store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);

        return();
    }

    op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);


    if (op == 2) { ;; withdrawal
        throw_unless(401, equal_slices(sender_address, admin_address));
        throw_unless(403, my_balance > 50000000); ;; 0.05 TON

        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(admin_address)
            .store_coins(my_balance - 50000000)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0, 32)
            .store_slice("Contract fund reallocation")
            .end_cell();

        send_raw_message(msg, 1);
        return();
    }

    if (op == 3) { ;; change_admin_address
    throw_unless(401, equal_slices(sender_address,admin_address));
        store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
    return();
    }

    if (op == 4) { ;; send nft to jackpot winner
    throw_unless(401, equal_slices(sender_address, admin_address));
    slice winner = in_msg_body~load_msg_addr();

    slice counters_slice = counters_ref.begin_parse();
    int jp = counters_slice~load_uint(16);
    int major = counters_slice~load_uint(16);
    int high = counters_slice~load_uint(16);
    int mid = counters_slice~load_uint(16);
    int low_mid = counters_slice~load_uint(16);
    int low = counters_slice~load_uint(16);
    int mini = counters_slice~load_uint(16);

    send_winning(JACKPOT_PRIZE(), winner, 0, token_wallet_address);

    jp += 1;

    cell new_ref = begin_cell()
    .store_uint(jp, 16)
    .store_uint(major, 16)
    .store_uint(high, 16)
    .store_uint(mid, 16)
    .store_uint(low_mid, 16)
    .store_uint(low, 16)
    .store_uint(mini, 16)
    .end_cell();

        store_data(new_ref, next_ticket_index, admin_address, price, ref_percent, token_wallet_address, collection_address);
    return();
    }

    if (op == 5) { ;; set token_wallet_address
    throw_unless(401, equal_slices(sender_address, admin_address));
        store_data(counters_ref, next_ticket_index, admin_address, price, ref_percent, in_msg_body~load_msg_addr(), collection_address);
    return();
    }
}

(int, int, int, int, int, int, int) get_counters() method_id {
    (cell counters_ref, _, _, _, _, _, _) = load_data();

    slice counters_slice = counters_ref.begin_parse();
    int jp = counters_slice~load_uint(16);
    int major = counters_slice~load_uint(16);
    int high = counters_slice~load_uint(16);
    int mid = counters_slice~load_uint(16);
    int low_mid = counters_slice~load_uint(16);
    int low = counters_slice~load_uint(16);
    int mini = counters_slice~load_uint(16);
    return (
        jp,
        major,
        high,
        mid,
        low_mid,
        low,
        mini
    );
}


(cell, int, slice, slice, int, int, slice) get_full_data() method_id {
    var (
        cell counters_ref,
        int next_ticket_index,
        slice admin_address,
        int price,
        int ref_percent,
        slice token_wallet_address,
        slice collection_address      ;; placeholder в конце load_data()
    ) = load_data();

    ;; возвращаем в «старом» порядке
    return (
        counters_ref,     ;; 0
    next_ticket_index,    ;; 1
    collection_address,   ;; 2 (вернули!)
    admin_address,        ;; 3
    price,                ;; 4
    ref_percent,          ;; 5
    token_wallet_address  ;; 6
);
}
