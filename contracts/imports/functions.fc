#include "params.fc";
#include "op-codes.fc";

cell generate_nft_content(int value, slice owner) {
    builder result = begin_cell();

    int divisor = 1;
    while (value / divisor >= 10) { divisor *= 10; }

    do {
        (int digit, value) = divmod(value, divisor);
        divisor /= 10;
        int char = 0;
        if (digit < 10) { char = 48 + digit; } else { char = 87 + digit; }
        ;;         '0' char code ^^       'a' char code - 10 ^^
        result = result.store_uint(char, 8);
    } until (divisor == 0);

    return begin_cell().store_slice(owner).store_ref(result.store_slice(".json").end_cell()).end_cell();
}

() send_winning(int value, slice address, int prize_code, slice token_wallet_address) impure inline {


        var forward_payload = begin_cell()
                .store_uint(op::send_prize(), 32)
                .store_uint(prize_code, 8)
                .end_cell();

        var transfer = begin_cell()
                .store_uint(0xf8a7ea5, 32)
                .store_uint(0, 64)
                .store_coins(value * jetton_decimals())
                .store_slice(address)
                .store_slice(my_address())
                .store_uint(0, 1)
                .store_coins(transfer_fee())
                .store_uint(1, 1)
                .store_ref(forward_payload)
                .end_cell();

        var msg = begin_cell()
                .store_uint(0x10, 6)
                .store_slice(token_wallet_address)
                .store_coins(transfer_fee())
                .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_ref(transfer)
                .end_cell();

        if (value != 0) {
                send_raw_message(msg, 1);
        }
}

