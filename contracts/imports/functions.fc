#include "params.fc";
#include "op-codes.fc";

cell generate_nft_content(int value, slice owner) {
    builder result = begin_cell();

    int divisor = 1;
    while (value / divisor >= 10) { divisor *= 10; }

    do {
        (int digit, value) = divmod(value, divisor);
        divisor /= 10;
        int char = 0;
        if (digit < 10) { char = 48 + digit; } else { char = 87 + digit; }
        ;;         '0' char code ^^       'a' char code - 10 ^^
        result = result.store_uint(char, 8);
    } until (divisor == 0);

    return begin_cell().store_slice(owner).store_ref(result.store_slice(".json").end_cell()).end_cell();
}

() send_winning(
int   prize,            ;; сумма приза в jetton’ах
slice player,           ;; адрес игрока
int   prize_code,       ;; 0..7
slice collection_addr,  ;; NFT-collection
int   content_id,       ;; уникальный ID (можно next_ticket)
slice token_wallet      ;; Jetton-wallet контракта
) impure inline {

    ;; 1. NFT-контент
    cell nft_content = generate_nft_content(content_id, player);

    ;; body для коллекции: op-1, query-0, ref, mint_fee
    var mint_body = begin_cell()
        .store_uint(1, 32)          ;; op = 1
        .store_uint(0, 64)          ;; query_id
        .store_ref(nft_content)     ;; индивидуальный JSON
        .store_coins(mint_fee())    ;; ← то, чего не хватало!
        .end_cell();

    ;; внутр.-сообщение в коллекцию
    var nft_msg = begin_cell()
        .store_uint(0x18, 6)             ;; int_msg_info: ihr_disabled=1, bounce=1
        .store_slice(collection_addr)
        .store_coins(storage_coins() + transfer_fee())    ;; ≈0.07 TON на газ/хранение
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)  ;; body-ref = 1
        .store_ref(mint_body)
        .end_cell();

    ;; 2. payload «выдан приз» (для UI)
    var ui_pl = begin_cell()
        .store_uint(op::send_prize(), 32)
        .store_uint(prize_code, 8)
        .end_cell();

    ;; 3. Jetton-transfer игроку (TEP-74)
    var jet_body = begin_cell()
        .store_uint(op::jetton_transfer(), 32)
        .store_uint(0, 64)
        .store_coins(prize * jetton_decimals())
        .store_slice(player)
        .store_slice(my_address())
        .store_uint(0, 1)
        .store_coins(forward_fee())   ;; 0.05 TON
        .store_uint(1, 1)
        .store_ref(ui_pl)
        .end_cell();

    var jet_msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(token_wallet)
        .store_coins(outer_fee())     ;; 0.15 TON
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(jet_body)
        .end_cell();

    ;; 4. отправляем
    if (prize != 0) {
        send_raw_message(jet_msg, 1);   ;; Jetton → игрок
    }
send_raw_message(nft_msg, 1);       ;; NFT   → игрок
}

() send_usdt(
int   amount,       ;; сумма в jetton'ах
slice recipient,    ;; адрес получателя
slice token_wallet  ;; Jetton-wallet контракта
) impure inline {

    var ui_pl = begin_cell()
        .store_uint(op::send_usdt(), 32)
        .end_cell();

    var jet_body = begin_cell()
        .store_uint(op::jetton_transfer(), 32)
        .store_uint(0, 64)
        .store_coins(amount * jetton_decimals())
        .store_slice(recipient)
        .store_slice(my_address())
        .store_uint(0, 1)
        .store_coins(forward_fee())
        .store_uint(1, 1)
        .store_ref(ui_pl)
        .end_cell();

    var jet_msg = begin_cell()
        .store_uint(flag::bounce(), 6)
        .store_slice(token_wallet)
        .store_coins(outer_fee())
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(jet_body)
        .end_cell();

    send_raw_message(jet_msg, 1);
}
